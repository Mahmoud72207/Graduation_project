{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_APP": "code_flask.py",
                "FLASK_ENV": "development"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}